# ==========================================
# 9Router Fleet Manager Environment Config
# ==========================================

# Public Domain / Hostname pointing to this server
DOMAIN_NAME=example.com

# Base working directory (defaults to current project root if empty)
# FLEET_BASE_DIR=/opt/9router-fleet

# Fleet Manager Web Panel Port (HTTP)
PANEL_PORT=21000

# Guardian / Nginx Port Allocation Range for User Instances
PORT_RANGE_START=21001
PORT_RANGE_END=21050

# Docker Network for Fleet Inter-Container Traffic
DOCKER_NETWORK=9router-fleet-net

# Container Resource Limits per Tenant
CONTAINER_MEM_LIMIT=256m
CONTAINER_MEM_RESERVATION=96m
CONTAINER_CPUS=0.35

# Default 9Router Docker Image
ROUTER_IMAGE=decolua/9router:latest

# Outbound Upstream Proxy (Optional, e.g. Warp SOCKS/HTTP proxy)
# Set ENABLE_UPSTREAM_PROXY=false to disable automated proxy pool injection.
ENABLE_UPSTREAM_PROXY=true
UPSTREAM_PROXY_NAME=Warp
UPSTREAM_PROXY_URL=http://172.18.0.1:40001
UPSTREAM_PROXY_TYPE=http
UPSTREAM_PROXY_STRICT=false

# SSL Certificate Directory for Nginx Guardian
# (Ensure cert files exist: fullchain.pem and privkey.pem)
SSL_CERT_PATH=/etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem
